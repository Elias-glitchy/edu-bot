# BUILD BOT 2.0 / Colleague Zero hackathon copy
# Copy values into your shell environment; this project does not auto-load .env files.
COLLEAGUE_ZERO_PORT=3005
COLLEAGUE_ZERO_DB=data/build-bot-colleague-zero.sqlite
COLLEAGUE_ZERO_RESEARCH_FIXTURE=0
COLLEAGUE_ZERO_BRAVE_SEARCH_API_KEY=
COLLEAGUE_ZERO_GOOGLE_SERVICE_ACCOUNT_JSON=
# Configure only a dedicated fictional-data service account. The live adapter
# requests the Google Sheets scope and must be verified against an exact sheet.
OPENAI_API_KEY=
COLLEAGUE_ZERO_OPENAI_EVERYDAY_MODEL=gpt-6-luna
COLLEAGUE_ZERO_OPENAI_REASONING_MODEL=gpt-6.1-sol
COLLEAGUE_ZERO_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Generate a 32-byte key once and keep it outside source control. Base64 or 64-character hex is accepted.
COLLEAGUE_ZERO_TOKEN_ENCRYPTION_KEY=
COLLEAGUE_ZERO_GOOGLE_CLIENT_ID=
COLLEAGUE_ZERO_GOOGLE_CLIENT_SECRET=
COLLEAGUE_ZERO_GOOGLE_REDIRECT_URI=http://localhost:3005/api/connectors/oauth/callback
COLLEAGUE_ZERO_GEMINI_EVERYDAY_MODEL=gemini-3.1-flash-lite
COLLEAGUE_ZERO_GEMINI_REASONING_MODEL=gemini-3.1-flash-lite
COLLEAGUE_ZERO_GEMINI_LIVE_MODEL=gemini-3.8-live
COLLEAGUE_ZERO_GEMINI_MULTIMODAL_MODEL=gemini-3.1-flash-lite
COLLEAGUE_ZERO_MCP_EXECUTION_ENABLED=1
COLLEAGUE_ZERO_MEMORY_ENABLED=1
COLLEAGUE_ZERO_SKILLS_ENABLED=1
COLLEAGUE_ZERO_COLLECTIONS_ENABLED=1
COLLEAGUE_ZERO_MULTI_AGENT_ENABLED=1
COLLEAGUE_ZERO_GEMINI_VOICE_ENABLED=1
COLLEAGUE_ZERO_GEMINI_MULTIMODAL_ENABLED=1
COLLEAGUE_ZERO_CODE_SANDBOX_ENABLED=0
COLLEAGUE_ZERO_COMPUTER_IMAGE=build-bot-computer:dev
COLLEAGUE_ZERO_DOCKER_COMMAND=
# This 6 GB development PC should run one Chromium desktop at a time.
# Starting another stops the oldest idle computer; persistent volumes remain.
COLLEAGUE_ZERO_MAX_RUNNING_COMPUTERS=1

# Three daily external workforce updates. Telegram users must open the bot and
# press Start first. WhatsApp uses an approved Cloud API template whose body has
# two text variables in this order: update title, update body.
COLLEAGUE_ZERO_TELEGRAM_BOT_TOKEN=
COLLEAGUE_ZERO_WHATSAPP_ACCESS_TOKEN=
COLLEAGUE_ZERO_WHATSAPP_PHONE_NUMBER_ID=
COLLEAGUE_ZERO_WHATSAPP_TEMPLATE_NAME=build_bot_update
COLLEAGUE_ZERO_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set this to the supported Meta Graph API version for your WhatsApp app.
COLLEAGUE_ZERO_WHATSAPP_GRAPH_VERSION=

# With no Google credential the education mission uses a clearly labelled,
# organization-scoped local mock gradebook provider. Never configure a live
# school sheet; use a dedicated fictional demonstration resource only.

# AI credentials are read by the server only. Gemini is the primary provider;
# OpenAI remains an optional text-chat fallback. Never place an API key in browser
# code, commit it to Git, or paste it into BUILD BOT chat messages.
